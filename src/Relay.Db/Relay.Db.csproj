<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <InvariantGlobalization>true</InvariantGlobalization>
    <RootNamespace>Relay.Db</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Relay.Core\Relay.Core.csproj" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.13" />
    <EmbeddedResource Include="schema.sql" />
    <EmbeddedResource Include="schema-catalog.sql" />
    <EmbeddedResource Include="schema-launch.sql" />
    <EmbeddedResource Include="schema-assets.sql" />
  </ItemGroup>
</Project>

